{
  "name": "worldwar-genshtab",
  "version": "1.0.0",
  "private": true,
  "description": "WorldWar: Генштаб — глобальная стратегия 1936–1948 для Android (WebView)",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "sim": "esbuild ../tools/sim/sim.mjs --bundle --platform=node --format=cjs --log-level=warning --outfile=dist/sim.cjs && node dist/sim.cjs",
    "test": "npm run sim -- --years 4 --quiet"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
